PORT=3000
MONGODB_URI=mongodb://localhost:27017/bootcamp
JWT_SECRET=change-me-to-a-long-random-string
# Must be DIFFERENT from JWT_SECRET, so a refresh token can never be used as an access token
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
CLIENT_URL=http://localhost:5173

# Optional: first admin, created on startup if it doesn't exist
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=admin123
